<% layout("layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-md-4" data-aos="fade-up" data-aos-duration="1000">
        <div class="card shadow">
            <div class="card-body text-center">
                <img src="https://ui-avatars.com/api/?name=<%= userProf.username %>&background=random" 
                     alt="User Avatar" class="rounded-circle mb-3" width="150" height="150">
                <h3 class="card-title text-capitalize"><%= userProf.username %></h3>
                <p class="text-muted"><%= userProf.email %></p>
                <hr>
                <div class="d-flex justify-content-around text-muted text-center">
                    <div>
                        <h5 class="mb-0"><%= campgrounds.length %></h5>
                        <small>Campgrounds</small>
                    </div>
                    <div>
                        <h5 class="mb-0"><%= reviews.length %></h5>
                        <small>Reviews</small>
                    </div>
                </div>
            </div>
            <% if (userProf.createdAt) { %>
                <div class="card-footer text-muted text-center">
                    Joined <%= moment(userProf.createdAt).format('MMMM Do YYYY') %>
                </div>
            <% } %>
        </div>
    </div>

    <div class="col-md-8" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="100">
        <h3 class="mb-4 text-capitalize">Campgrounds by <%= userProf.username %></h3>
        <% if (campgrounds.length === 0) { %>
            <div class="alert alert-info">This user hasn't submitted any campgrounds yet.</div>
        <% } else { %>
            <% for (let campground of campgrounds) { %>
                <div class="card mb-3 shadow-sm border-0">
                    <div class="row g-0">
                        <div class="col-md-4">
                            <% if (campground.images.length) { %>
                                <img src="<%= campground.images[0].url %>" class="img-fluid rounded-start h-100" style="object-fit: cover;" alt="<%= campground.title %>">
                            <% } else { %>
                                <img src="/images/placeholder.png" class="img-fluid rounded-start h-100" style="object-fit: cover;" alt="default">
                            <% } %>
                        </div>
                        <div class="col-md-8">
                            <div class="card-body">
                                <h5 class="card-title"><%= campground.title %></h5>
                                <p class="card-text text-muted"><%= campground.location %></p>
                                <p class="card-text"><%= campground.description.substring(0, 100) %>...</p>
                                <a href="/campgrounds/<%= campground._id %>" class="btn btn-sm btn-primary">View Campground</a>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        <% } %>

        <hr class="my-5">

        <h3 class="mb-4 text-capitalize">Favorites (<%= likedCampgrounds.length %>)</h3>
        <% if (likedCampgrounds.length === 0) { %>
            <div class="alert alert-light">This user hasn't liked any campgrounds.</div>
        <% } else { %>
            <div class="row">
            <% for (let campground of likedCampgrounds) { %>
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm h-100 border-0">
                        <% if (campground.images.length) { %>
                            <img src="<%= campground.images[0].url %>" class="card-img-top" style="height: 150px; object-fit: cover;" alt="<%= campground.title %>">
                        <% } %>
                        <div class="card-body">
                            <h6 class="card-title"><%= campground.title %></h6>
                            <a href="/campgrounds/<%= campground._id %>" class="btn btn-sm btn-outline-danger">❤️ View</a>
                        </div>
                    </div>
                </div>
            <% } %>
            </div>
        <% } %>
    </div>
</div>
