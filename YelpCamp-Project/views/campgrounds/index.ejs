<% layout("layouts/boilerplate") %>

<!-- Floating Search Bar -->
<div class="container mb-5 mt-4" data-aos="fade-down" data-aos-duration="1000">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg" style="border-radius: 50px; background: rgba(255,255,255,0.02); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.1);">
                <div class="card-body p-2">
                    <form action="/campgrounds" method="GET" class="d-flex w-100">
                        <input class="form-control border-0 bg-transparent text-white ms-3" type="search" placeholder="Discover your next adventure..." name="search" aria-label="Search" value="<%= searchQuery || '' %>" style="box-shadow: none; outline: none;">
                        <button class="btn btn-primary rounded-pill px-4 ms-2" type="submit">Search</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4 px-2" data-aos="fade-right">
    <h1 class="mb-0">Explore Campgrounds</h1>
    <a href="/campgrounds/new" class="btn btn-outline-success rounded-pill px-4 border-2">Add New</a>
</div>

<div id="cluster-map" data-aos="zoom-in" data-aos-duration="1200" class="mb-5"></div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
    <% let delay = 0; %>
    <% for (let campground of campgrounds.docs) { %>
        <div class="col" data-aos="fade-up" data-aos-delay="<%= delay %>">
            <div class="card h-100 shadow-sm">
                <!-- Bleeding Edge Image -->
                <% if (campground.images.length) { %>
                    <img class="card-img-top"
                         src="<%= campground.images[0].url %>"
                         style="height: 250px; object-fit: cover; border-bottom-left-radius: 0; border-bottom-right-radius: 0;"
                         alt="<%= campground.title %>">
                <% } else { %>
                    <img class="card-img-top"
                         src="/images/placeholder.png"
                         style="height: 250px; object-fit: cover; border-bottom-left-radius: 0; border-bottom-right-radius: 0;"
                         alt="Default image">
                <% } %>
                
                <div class="card-body d-flex flex-column pt-4 px-4 pb-3">
                    <h5 class="card-title fw-bold mb-1"><%= campground.title %></h5>
                    <p class="text-muted small mb-3"><i class="fas fa-map-marker-alt me-1"></i> <%= campground.location %></p>
                    
                    <p class="card-text text-white-50" style="display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                        <%= campground.description %>
                    </p>
                    
                    <div class="mt-auto pt-3 border-top border-secondary d-flex justify-content-between align-items-center">
                        <a href="/campgrounds/<%= campground._id %>" class="btn btn-sm btn-primary rounded-pill px-3">
                            Explore <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                        <% if (campground.createdAt) { %>
                            <span class="text-muted small"><%= moment(campground.createdAt).fromNow() %></span>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <% delay += 100; if(delay > 300) delay = 0; %>
    <% } %>
</div>

<nav aria-label="Page navigation" data-aos="fade-up">
    <ul class="pagination justify-content-center flex-wrap">
        <li class="page-item <%= !campgrounds.hasPrevPage ? 'disabled' : '' %>">
            <a class="page-link rounded-pill px-3 mx-1 bg-dark text-white border-secondary" href="/campgrounds?page=<%= campgrounds.prevPage %>&<%= queryParams %>" tabindex="-1">Prev</a>
        </li>
        <% for(let i = 1; i <= campgrounds.totalPages; i++) { %>
            <li class="page-item <%= campgrounds.page === i ? 'active' : '' %>">
                <a class="page-link rounded-circle mx-1 <%= campgrounds.page === i ? 'bg-success border-success' : 'bg-dark text-white border-secondary' %>" href="/campgrounds?page=<%= i %>&<%= queryParams %>"><%= i %></a>
            </li>
        <% } %>
        <li class="page-item <%= !campgrounds.hasNextPage ? 'disabled' : '' %>">
            <a class="page-link rounded-pill px-3 mx-1 bg-dark text-white border-secondary" href="/campgrounds?page=<%= campgrounds.nextPage %>&<%= queryParams %>">Next</a>
        </li>
    </ul>
</nav>

<%- "<script>" %>
const maptilerApiKey = "<%- process.env.MAPTILER_API_KEY %>";
const campgrounds = {
  type: "FeatureCollection",
  features: <%- JSON.stringify(
    campgrounds.docs.map(campground => ({
      type: "Feature",
      geometry: campground.geometry,
      properties: { popUpMarkup: campground?.properties?.popUpMarkup }
    }))
  ) %>
};
<%- "</script>" %>
<script src="/javascripts/clusterMap.js"></script>
