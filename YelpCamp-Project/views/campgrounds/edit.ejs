<%layout("layouts/boilerplate")%>

    <div class="row">
        <h1 class="text-center">Edit Campground</h1>
        <div class="col-6 offset-3">
            <form action="/campgrounds/<%= campground._id %>/?_method=PUT" method="post">
                <div class="mb-3">
                    <label class="form-label" for="title">Title</label>
                    <input class="form-control" type="text" id="title" value="<%=campground.title%>" name="title">
                </div>
                <div class="mb-3">
                    <label class="form-label" for="location">Location</label>
                    <input class="form-control" type="text" id="location" value="<%= campground.location%>"
                        name="location">
                </div>
                <div class="mb-3">
                    <label class="form-label" for="image">Image Url</label>
                    <input class="form-control" type="text" id="image" value="<%= campground.image %>" name="image">
                </div>
                <div class="mb-3">
                    <label class="form-label" for="price">Campground Price</label>
                    <div class="input-group">
                        <span class="input-group-text" id="basic-addon1">$</span>
                        <input class="form-control" type="text" id="price" value="<%= campground.price %>" name="price"
                            aria-label="price" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="description">Description</label>
                    <textarea class="form-control" type="text" id="description"
                        name="description"><%=campground.description%></textarea>
                </div>
                <div class="mb-3">
                    <button class="btn btn-info">Edit Campground</button>
                </div>
            </form>
            <a href="/campgrounds/<%=campground._id %>">Back to Campground</a>
        </div>
    </div>
    </body>

    </html>