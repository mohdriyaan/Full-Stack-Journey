<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comments Index</title>
</head>
<body>
    <h1>Comments</h1>
    <ul>
        <% for (let comment of comments) { %>
            <li><%= comment.comment %> - <%= comment.username %></li>
            <a href="/comments/<%=comment.id%>">Details</a>
            <a href="/comments/<%=comment.id%>/edit">Edit Comment</a>
        <% } %>
    </ul>
    <a href="/comments/new">Add a New Comment</a>

</body>
</html>