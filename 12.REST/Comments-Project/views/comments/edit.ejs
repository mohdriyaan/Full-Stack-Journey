<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Comment</title>
</head>
<body>
    <h1>Edit User ID : <%= comment.id %></h1>
    <form action="/comments/<%=comment.id%>/?_method=PATCH" method="post">
        <section>
            <label for="newComment">Ener new comment : </label>
            <br>
            <textarea name="newComment" id="newComment" rows="4" cols="32">
                <%=comment.comment%>
            </textarea>
        </section>
        <button type="submit">Submit</button>
    </form>
    
    <a href="/comments">Back to index</a>
</body>
</html>