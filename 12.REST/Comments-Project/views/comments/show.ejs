<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show Comment</title>
</head>
<body>
    <h1>User ID :- <%= comment.id %></h1>
    <h2>Comments : <%= comment.comment %> - <%= comment.username %></h2>
    <a href="/comments">Back to index</a>
    <a href="/comments/<%=comment.id%>/edit">Edit Comment</a>
    <form action="/comments/<%=comment.id%>?_method=DELETE" method="post">
        <button>DELETE</button>
    </form>

</body>
</html>